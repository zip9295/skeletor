{
  "name": "dj_avolak/skeletor",
  "license": "MIT",
  "type": "library",
  "repositories": [
    {
      "type": "git",
      "url": "https://bitbucket.org/greenfriends/skeletorjs"
    },
    {
      "type": "git",
      "url": "https://bitbucket.org/dj_avolak/skeletor-asset-installer"
    }
  ],
  "require": {
    "php": ">=8.4",
    "ext-pdo": "*",
    "ext-redis": "*",
    "ext-igbinary": "*",
    "ext-imagick": "*",
    "ext-gd": "*",
    "ext-json": "*",
    "laminas/laminas-session": "*",
    "monolog/monolog": "^3",
    "php-di/php-di": "^7",
    "nikic/fast-route": "^1",
    "guzzlehttp/psr7": "^3",
    "guzzlehttp/guzzle": "^8",
    "league/plates": "^3",
    "league/event": "^3",
    "doctrine/orm": "^3",
    "doctrine/dbal": "^4",
    "beberlei/doctrineextensions": "^1",
    "symfony/cache": "^7",
    "symfony/serializer": "^7",
    "symfony/property-access": "^7",
    "tracy/tracy": "^2",
    "nesbot/carbon": "^3",
    "phpmailer/phpmailer": "^7",
    "tamtamchik/simple-flash": "*",
    "greenfriends/skeletorjs": "^3.0",
    "dj_avolak/skeletor-asset-installer": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11",
    "doctrine/migrations": "^3.9",
    "phpmd/phpmd": "*",
    "roave/security-advisories": "dev-master",
    "rregeer/phpunit-coverage-check": "*"
  },
  "autoload": {
    "psr-4": {
      "Skeletor\\": "src"
    }
  },
  "config": {
    "preferred-install": "dist",
    "bin-dir": "vendor/bin/",
    "allow-plugins": {
      "dj_avolak/skeletor-asset-installer": true
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Skeletor\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": [
      "@putenv XDEBUG_MODE=coverage",
      "phpunit --coverage-html public/coverage"
    ]
  }
}
